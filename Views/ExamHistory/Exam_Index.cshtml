@model IEnumerable<專題MVC修正.Models.ExamMaster>
@{
    ViewBag.Title = "測驗卷清單";
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int total = ViewBag.TotalCount ?? 0;
    int totalPages = (int)Math.Ceiling((double)total / pageSize);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold mb-3">測驗卷清單</h2>

    <!-- ⭐ 右上角：回首頁 -->
    <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
        回管理後台
    </a>
</div>

@if (TempData["Msg"] != null)
{
    <div class="alert alert-info">@TempData["Msg"]</div>
}

<form method="get" class="mb-3 d-flex">
    <input type="text" name="keyword" class="form-control me-2" placeholder="搜尋測驗名稱..."
           value="@ViewBag.Keyword" style="max-width:250px;" />
    <button type="submit" class="btn btn-primary">搜尋</button>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>ExamID</th>
            <th>測驗名稱</th>
            <th>開始時間</th>
            <th>結束時間</th>
            <th>時長(分)</th>
            <th style="width:180px;">操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.ExamID</td>
                <td>@x.ExamName</td>
                <td>@x.ExamSDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@x.ExamEDate.ToString("yyyy/MM/dd HH:mm")</td>
                <td>@x.ExamDuraionTime</td>
                <td>
                    @Html.ActionLink(
                        linkText: "詳細",
                        actionName: "Exam_Details",
                        controllerName: "ExamHistory",
                        routeValues: new { id = x.ExamID },
                        htmlAttributes: new { @class = "btn btn-sm btn-primary me-2" })

                    @using (Html.BeginForm("Exam_Delete", "ExamHistory", new { id = x.ExamID }, FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('確定要刪除這份考卷（ID=@x.ExamID）嗎？此動作無法復原。');">
                            刪除
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Exam_Index", new { page = i, keyword = ViewBag.Keyword })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
