@model 專題MVC修正.Models.DTOs.ExamBookDetailVM

@{
    ViewBag.Title = "作答結果";
}

<div class="container py-4">

    <h2 class="fw-bold mb-3">作答結果</h2>

    <!-- 測驗概要 -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row gy-3">

                <!-- 測驗名稱 -->
                <div class="col-md-4">
                    <div class="text-muted mb-1">測驗卷</div>
                    <h4 class="fw-bold mb-0">
                        @Model.ExamName
                        <small class="text-muted ms-2">(@Model.ExamId)</small>
                    </h4>
                </div>

                <!-- 學生資訊 -->
                <div class="col-md-4">
                    <div class="text-muted mb-1">學生</div>
                    <h5 class="fw-bold mb-0">
                        @Model.StdName
                        <small class="text-muted ms-2">(@Model.ExamStdPK)</small>
                    </h5>
                </div>

                <!-- 題數 -->
                <div class="col-md-1 text-md-end">
                    <div class="small text-muted">題數</div>
                    <div class="fs-5 fw-bold">@Model.TotalQuestions</div>
                </div>

                <!-- 答對 -->
                <div class="col-md-1 text-md-end">
                    <div class="small text-muted">答對</div>
                    <div class="fs-5 fw-bold">@Model.CorrectCount</div>
                </div>

                <!-- 分數 -->
                <div class="col-md-2 text-md-end">
                    <div class="small text-muted">總分</div>
                    <div class="fs-5 fw-bold">
                        @(Model.TotalScore.HasValue
                              ? Model.TotalScore.Value.ToString("0")
                              : "-")
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 詳解 -->
    <h5 class="fw-bold mb-3">詳解</h5>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;">題號</th>
                    <th>題目</th>
                    <th style="width:120px;" class="text-center">學生答案</th>
                    <th style="width:120px;" class="text-center">正確答案</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows != null && Model.Rows.Any())
                {
                    foreach (var row in Model.Rows)
                    {
                        var rowClass = row.IsCorrect ? "" : "table-danger";

                        <tr class="@rowClass">
                            <td>@row.No</td>
                            <td>@row.QuestionText</td>
                            <td class="text-center">@row.StdAns</td>
                            <td class="text-center">@row.CorrectAns</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            尚無題目紀錄。
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 返回 -->
    
    <div class="mt-3 d-flex gap-2">
        <a href="@Url.Action("Index", "ExamBook")" class="btn btn-secondary">
            返回測驗本列表
        </a>

        <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
            回到首頁
        </a>
    </div>

</div> <!-- container end -->

