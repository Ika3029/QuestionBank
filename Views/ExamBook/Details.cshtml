@model 專題MVC修正.Models.DTOs.ExamBookDetailVM

@{
    ViewBag.Title = "作答結果";
}

<div class="container py-4">

    <h2 class="fw-bold mb-3">作答結果</h2>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3">
                <div>
                    <div class="text-muted mb-1">測驗卷</div>
                    <h4 class="fw-bold mb-0">
                        @Model.ExamName
                        <small class="text-muted ms-2">(@Model.ExamId)</small>
                    </h4>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    <div class="small text-muted">題數</div>
                    <div class="fs-5 fw-bold">@Model.TotalQuestions</div>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    <div class="small text-muted">答對</div>
                    <div class="fs-5 fw-bold">@Model.CorrectCount</div>
                </div>
                <div class="mt-3 mt-md-0 text-md-end">
                    <div class="small text-muted">總分</div>
                    <div class="fs-5 fw-bold">
                        @(Model.TotalScore.HasValue ? Model.TotalScore.Value.ToString("0") : "-")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3">詳解</h5>

    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th style="width:60px;">題號</th>
                    <th>題目</th>
                    <th style="width:120px;" class="text-center">我的答案</th>
                    <th style="width:120px;" class="text-center">正確答案</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    // 答錯顏色加深，類似你截圖那種 pink 底色
                    var rowClass = row.IsCorrect ? "" : "table-danger";

                    <tr class="@rowClass">
                        <td>@row.No</td>
                        <td>@row.QuestionText</td>
                        <td class="text-center">@row.StdAns</td>
                        <td class="text-center">@row.CorrectAns</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a href="@Url.Action("Index", "ExamBook")" class="btn btn-secondary">
            返回我的測驗本
        </a>
    </div>
</div>
