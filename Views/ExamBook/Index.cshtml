@using System
@using 專題MVC修正.Models.DTOs
@model PagedResult<ExamBookSummaryVM>

@{
    ViewBag.Title = "測驗本總覽";
    string keyword = ViewBag.Keyword as string ?? "";

    int totalPages = (int)Math.Ceiling(Model.TotalItems / (double)Model.PageSize);
    if (totalPages < 1) { totalPages = 1; }
}

<div class="container py-4">

    <!-- ✅ 標題 + 右上角回管理後台 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold mb-0">測驗本總覽（全部學生）</h2>

        <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">
            回管理後台
        </a>
    </div>

    <p class="text-muted mb-4">
        這裡會顯示所有學生在系統中做過的測驗紀錄，每一列代表某一位學生的一次完整測驗。
    </p>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">
            @TempData["Msg"]
        </div>
    }

    <!-- 🔍 簡潔版搜尋列（像你截圖那樣） -->
    <div class="mb-3" style="max-width: 420px;">
        @using (Html.BeginForm("Index", "ExamBook", FormMethod.Get, new { @class = "d-flex" }))
        {
            <input type="text"
                   name="keyword"
                   value="@keyword"
                   class="form-control me-2"
                   placeholder="搜尋測驗名稱..." />

            @* 保留目前每頁筆數 *@
            @Html.Hidden("pageSize", Model.PageSize)

            <button type="submit" class="btn btn-primary">
                搜尋
            </button>
        }
    </div>

    @if (Model.TotalItems == 0)
    {
        <div class="alert alert-info">
            目前還沒有任何符合條件的測驗紀錄。
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">學生姓名</th>
                        <th scope="col">學生編號</th>
                        <th scope="col">測驗編號</th>
                        <th scope="col" class="text-center">題數</th>
                        <th scope="col" class="text-center">答對題數</th>
                        <th scope="col" class="text-center">成績</th>
                        <th scope="col" class="text-center">開始時間</th>
                        <th scope="col" class="text-center">完成時間</th>
                        <th scope="col" class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Query)
                    {
                        int examId = item.ExamID ?? 0;

                        string scoreText = item.Score.HasValue
                            ? item.Score.Value.ToString("0")
                            : "-";

                        string startTimeText = item.StartTime.HasValue
                            ? item.StartTime.Value.ToString("yyyy/MM/dd HH:mm")
                            : "-";

                        string endTimeText = item.EndTime.HasValue
                            ? item.EndTime.Value.ToString("yyyy/MM/dd HH:mm")
                            : "未完成";

                        <tr>
                            <td>@item.StdName</td>
                            <td>@item.ExamStdPK</td>
                            <td>@examId</td>
                            <td class="text-center">@item.TotalQuestions</td>
                            <td class="text-center">@item.CorrectCount</td>
                            <td class="text-center">@scoreText</td>
                            <td class="text-center">@startTimeText</td>
                            <td class="text-center">@endTimeText</td>
                            <td class="text-end">
                                <a href="@Url.Action(
                                        "Details",
                                        "ExamBook",
                                        new { examId = examId, stdPk = item.ExamStdPK, attemptTicks = item.AttemptTicks }
                                    )"
                                   class="btn btn-outline-primary btn-sm me-1">
                                    查看明細
                                </a>

                                @using (Html.BeginForm("Delete", "ExamBook", FormMethod.Post,
                                    new
                                    {
                                        @class = "d-inline",
                                        onsubmit = "return confirm('確定要刪除這次的測驗紀錄嗎？');"
                                    }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("examId", examId)
                                    @Html.Hidden("stdPk", item.ExamStdPK)
                                    @Html.Hidden("attemptTicks", item.AttemptTicks)

                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        刪除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 分頁列 -->
        if (totalPages > 1)
        {
            <div class="mt-3 text-center">
                @{
                    // 顯示前 10 個頁碼
                    int displayCount = Math.Min(10, totalPages);
                }

                @for (int i = 1; i <= displayCount; i++)
                {
                    if (i == Model.Page)
                    {
                        <span class="fw-bold text-primary">@i</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index",
                                new { page = i, pageSize = Model.PageSize, keyword = keyword })">
                            @i
                        </a>
                    }

                    @:
                }

                @* 若總頁數超過 10，顯示「…」與 下一頁 / 最後一頁 *@
                @if (totalPages > displayCount)
                {
                    @:···

                    var nextPage = Model.Page < totalPages ? Model.Page + 1 : totalPages;

                    <a href="@Url.Action("Index",
                            new { page = nextPage, pageSize = Model.PageSize, keyword = keyword })">
                        &raquo;
                    </a>
                    @:
                    <a href="@Url.Action("Index",
                            new { page = totalPages, pageSize = Model.PageSize, keyword = keyword })">
                        &raquo;&raquo;
                    </a>
                }
            </div>
        }
    }
</div>
