
@using System.Linq
@model IEnumerable<專題MVC修正.Models.DTOs.WrongBookItemVM>

@{
    ViewBag.Title = "我的錯題本";
}

<div class="container py-4">
    <h2 class="fw-bold mb-3">我的錯題本</h2>
    <p class="text-muted mb-4">
        這裡會整理出你曾經答錯的題目，每一題只顯示最後一次作答結果，方便你針對弱點再複習。
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            目前還沒有錯題紀錄，先去做幾份測驗試試看吧！
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px;">題號</th>
                        <th>題目</th>
                       
                        <th style="width:120px;" class="text-center">錯誤次數</th>
                        <th style="width:180px;" class="text-center">最後作答時間</th>
                        <th style="width:140px;" class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int no = 1;
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="table-danger">
                            <td>@no</td>
                            <td>@item.QuestionText</td>
                          
                            <td class="text-center">@item.WrongCount</td>
                            <td class="text-center">
                                @(item.LastAnsTime.HasValue
                                    ? item.LastAnsTime.Value.ToString("yyyy/MM/dd HH:mm")
                                    : "-")
                            </td>
                            <td class="text-end">
                                <a href="@Url.Action("Detail", "WrongBook", new { mqbpk = item.MQBPK })"
                                   class="btn btn-outline-primary btn-sm">
                                    明細
                                </a>
                            </td>

                        </tr>
                        no++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>
