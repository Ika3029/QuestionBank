@{
    var action = (ViewContext.RouteData.Values["action"] ?? "").ToString();
    var controller = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    Func<string, string, string> isActive = (ctrl, act) =>
    {
        bool mc = controller.Equals(ctrl, System.StringComparison.OrdinalIgnoreCase);
        bool ma = string.IsNullOrEmpty(act) || action.Equals(act, System.StringComparison.OrdinalIgnoreCase);
        return (mc && ma) ? "active" : "";
    };
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@(string.IsNullOrEmpty(ViewBag.Title) ? "QuestionBank ‧ 練習題庫" : ViewBag.Title + " - QuestionBank")</title>

    <!-- 字型 & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body class="app-body">
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // ========= 先取得 Modal 元素 & 只建立一次實例 =========
            var modalEl = document.getElementById('loginRequiredModal');
            var loginModal = null;

            if (modalEl && window.bootstrap) {
                loginModal = new bootstrap.Modal(modalEl);

                // ⭐ 不管用哪一個按鈕關閉，只要 Modal 關掉就把遮罩/狀態清乾淨
                modalEl.addEventListener('hidden.bs.modal', function () {
                    document.body.classList.remove('modal-open');
                    var backdrops = document.querySelectorAll('.modal-backdrop');
                    backdrops.forEach(function (bd) { bd.remove(); });
                });
            }

            // ========= 點「需要登入」的卡片 → 打開提示視窗 =========
            var links = document.querySelectorAll('.require-login');
            links.forEach(function (link) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (loginModal) {
                        loginModal.show();
                    }
                });
            });

            // ========= 點「前往登入」 → 關掉 Modal + 捲到登入卡片 + 閃動 =========
            var goLoginBtn = document.getElementById('go-login-btn');
            if (goLoginBtn) {
                goLoginBtn.addEventListener('click', function (e) {
                    e.preventDefault(); // 不要讓 a 自己跳錨點

                    if (loginModal) {
                        loginModal.hide(); // 會觸發 hidden.bs.modal，順便清遮罩
                    }

                    var loginCard = document.getElementById('login-card');
                    if (!loginCard) return;

                    setTimeout(function () {
                        loginCard.scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                        loginCard.classList.add('login-highlight');

                        setTimeout(function () {
                            loginCard.classList.remove('login-highlight');
                        }, 1500);
                    }, 200);
                });
            }
        });
    </script>


    <style>
        .hover-card {
            transition: all 0.25s ease;
            cursor: pointer;
        }

            .hover-card:hover {
                background: #f8faff; /* 微亮藍白 */
                transform: translateY(-4px); /* 微浮起 */
                box-shadow: 0 8px 20px rgba(0,0,0,0.1); /* 漂亮陰影 */
            }
        /* ✅ 登入卡片被引導時的閃動效果 */
        #login-card.login-highlight {
            animation: login-flash 0.6s ease-in-out 0s 2;
        }

        /* Razor 裡要寫 @@keyframes */
        @@keyframes login-flash {
            0% {
                transform: scale(1);
                box-shadow: 0 0 0 rgba(37, 99, 235, 0);
            }

            50% {
                transform: scale(1.02);
                box-shadow: 0 0 0 5px rgba(37, 99, 235, 0.4);
            }

            100% {
                transform: scale(1);
                box-shadow: 0 0 0 rgba(37, 99, 235, 0);
            }
        }
    </style>
    <!-- 登入提示 Modal（全站共用） -->
    <div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginRequiredLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="loginRequiredLabel">登入即可體驗更多內容</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0">
                    <p class="text-secondary mb-0">
                        目前僅開放已登入學生使用此功能，請先完成登入，再回來繼續操作。
                    </p>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        先逛逛就好
                    </button>
                    <a href="#login-card"
                       id="go-login-btn"
                       class="btn btn-primary">
                        前往登入
                    </a>



                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top app-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index","Home")">
                <span class="brand-badge">QB</span>
                <span>
                    <span class="fw-bold">QuestionBank</span>
                    <small class="text-muted d-none d-sm-inline">練習題庫</small>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="切換導覽">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <!-- 左側導覽 -->
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        @Html.ActionLink("首頁", "Index", "Home", null, new { @class = "nav-link " + isActive("Home", "Index") })
                    </li>
                    <li class="nav-item">
                        @Html.ActionLink("練習", "Index", "Practice", null, new { @class = "nav-link " + isActive("Practice", "Index") })
                    </li>

                    <!-- ✅ 測驗卷：登入才可用，未登入叫出登入提示 Modal -->
                    @if (Session["StdID"] != null)
                    {
                        <li class="nav-item">
                            @Html.ActionLink(
                                "測驗卷",
                                "Exams_Index",
                                "ManageExams",
                                null,
                                new { @class = "nav-link " + isActive("ManageExams", "Exams_Index") }
                            )
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a href="javascript:void(0);" class="nav-link require-login">
                                測驗卷
                            </a>
                        </li>
                    }

                    @{
                        var admins = new[] { "T1234567", "1111410015" };
                    }
                    @if (Session["StdID"] != null && admins.Contains(Session["StdID"].ToString()))
                    {
                        <li class="nav-item">
                            @Html.ActionLink("管理後台", "Index", "Admin", null, new { @class = "nav-link" })
                        </li>
                    }
                </ul>

                <!-- 右側：登入狀態區 -->
                <ul class="navbar-nav ms-lg-3 ms-auto align-items-center">
                    @if (Session["StdID"] != null)
                    {
                        <li class="nav-item me-2">
                            <div class="d-flex align-items-center px-3 py-1"
                                 style="background:#f0f6ff; border:1px solid #d0e2ff; border-radius:12px; font-size:0.9rem;">
                                <i class="bi bi-person-circle me-2 text-primary" style="font-size:1.1rem;"></i>
                                <span class="text-primary fw-semibold">@Session["StdName"] 同學</span>
                            </div>
                        </li>

                        <li class="nav-item me-3">
                            <a href="@Url.Action("Logout", "Account")"
                               class="btn btn-outline-danger btn-sm px-3 py-1 d-flex align-items-center gap-1"
                               style="border-radius: 10px;">
                                <i class="bi bi-box-arrow-right"></i> 登出
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-3">

                            <a href="#login-card"
                               id="go-login-btn"
                               class="btn btn-outline-primary btn-sm px-3 py-1"
                               style="border-radius: 10px;">
                                學生登入
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main -->
    <main class="py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="border-top">
        <div class="container py-4 small text-muted d-flex justify-content-between flex-wrap gap-2">
            <span>© @DateTime.Now.Year QuestionBank — 模擬練習平台</span>
            <span>聯絡我們：<a href="mailto:nqbe608@gmail.com">nqbe608@gmail.com</a></span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <!-- ✅ 全站 require-login 事件：包括導覽列「測驗卷」與卡片 -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var links = document.querySelectorAll('.require-login');
            links.forEach(function (link) {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    var modalEl = document.getElementById('loginRequiredModal');
                    if (modalEl && window.bootstrap) {
                        var m = bootstrap.Modal.getOrCreateInstance(modalEl);
                        m.show();
                    }
                });
            });
        });
    </script>
</body>
</html>
