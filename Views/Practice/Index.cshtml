@{
    ViewBag.Title = "練習 — 單題";
}

<div class="container py-3">
    <h3 class="mb-3">練習條件</h3>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-warning">@TempData["Msg"]</div>
    }

    @* 這裡一定要指向動作 Single，而不是 Practice_Single *@
    <form method="get" action="@Url.Action("Single", "Practice")">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">科別 (QClass)</label>
                @Html.DropDownList("classId", ViewBag.ClassList as SelectList, "請選擇科別", new { @class = "form-select" })
            </div>
            <div class="col-md-6">
                <label class="form-label">練習模式</label>
                <select class="form-select" disabled>
                    <option selected>單題練習</option>
                </select>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">開始練習</button>
        </div>
    </form>
</div>
