

@model 專題MVC修正.Models.ExamMaster
@{
    ViewBag.Title = "Details";
    var details = ViewBag.Details as IEnumerable<dynamic>; // 由 Controller 塞匿名型別
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">測驗卷：@Model.ExamName (@Model.ExamID)</h3>
    <a class="btn btn-outline-secondary" href="@Url.Action("Exams_Index")">返回列表</a>
</div>

<div class="card-clean p-4 mb-3">
    <div class="row">
        <div class="col-md-4"><div class="text-secondary small">ExamID</div><div class="fw-medium">@Model.ExamID</div></div>
        
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h5 class="m-0">已加入題目</h5>
    <a class="btn btn-primary" href="@Url.Action("SelectQuestions", new { id = Model.ExamID, team = 0, score = 1 })">手動挑題</a>
</div>

@if (details == null || !details.Any())
{
    <div class="alert alert-info">此測驗卷尚未加入題目。</div>
}
else
{
    <div class="table-responsive card-clean p-0">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width:100px;">DetID</th>
                    <th>題目內容</th>
                    <th style="width:120px;">分數</th>
                    <th style="width:140px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in details)
                {
                    <tr>
                        <td>@d.ExamDetPK</td>
                        <td>@Html.Raw(d.QContent)</td>
                        <td>@d.ExamDefaultScore</td>
                        <td>
                            @using (Html.BeginForm("RemoveDetail", "ManageExams", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@d.ExamDetPK" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">移除</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


