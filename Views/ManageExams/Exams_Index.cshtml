

@using PagedList.Mvc
@using PagedList
@model IPagedList<專題MVC修正.Models.ExamMaster>
@{
    ViewBag.Title = "Exams_Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="m-0">測驗卷列表</h3>
    <a class="btn btn-primary" href="@Url.Action("Exams_Create")">建立測驗卷</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">目前尚無測驗卷，點右上角「建立測驗卷」。</div>
}
else
{
    <div class="table-responsive card-clean p-0">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th style="width: 100px;">ExamID</th>
                    <th>名稱</th>
                    <th style="width: 200px;">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.ExamID</td>
                        <td>@x.ExamName</td>
                        <td>
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Details", new { id = x.ExamID })">明細</a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        @Html.PagedListPager(Model, p => Url.Action("Exams_Index", new { page = p }))
    </div>
}
