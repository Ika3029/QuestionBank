

@model dynamic
@{
    ViewBag.Title = "Exams_Create";
}


<h3 class="mb-3">建立測驗卷</h3>

@using (Html.BeginForm("Exams_Create", "ManageExams", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="card-clean p-4">
        <div class="mb-3">
            <label class="form-label">測驗卷名稱</label>
            <input name="ExamName" class="form-control" placeholder="例如：內科模擬考（一）" />
        </div>

        <div class="mb-3">
            <label class="form-label">科別 / 隊伍（MQBTeam）</label>
            @Html.DropDownList("MQBTeamPK", (SelectList)ViewBag.MQBTeamPK, "-- 請選擇 --", new { @class = "form-select" })
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">是否隨機抽題</label><br />
                <input type="checkbox" name="IsRandom" value="true" /> <span class="ms-1">使用隨機題</span>
                <input type="hidden" name="IsRandom" value="false" />
            </div>
            <div class="col-md-4">
                <label class="form-label">抽題數量（隨機時）</label>
                <input type="number" name="QuestionCount" value="10" min="1" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">每題分數</label>
                <input type="number" name="ScorePerQuestion" value="1" min="1" class="form-control" />
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button class="btn btn-primary" type="submit">建立</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Exams_Index")">返回列表</a>
        </div>
    </div>
}
