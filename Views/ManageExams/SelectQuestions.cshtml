@using 專題MVC修正.Models.DTOs
@using PagedList;
@using PagedList.Mvc;
@model IPagedList<ExamDselectlist>

@{
    ViewBag.Title = "SelectQuestions";
    var examId = (int)ViewBag.ExamMasterPK;
    var score = (double)ViewBag.ScorePerQuestion;

    var qclass = ViewBag.QClass as int?;
    var qtype = ViewBag.QType as int?;
    var chapter = ViewBag.Chapter as int?;
    var session = ViewBag.Session as int?;
    string keyword = ViewBag.Keyword as string;
}

<h3 class="mb-3">手動挑題</h3>

<!-- 篩選列（GET） -->
<form method="get" action="@Url.Action("SelectQuestions", "ManageExams")" class="row g-2 align-items-end mb-3">
    <input type="hidden" name="id" value="@examId" />
    <input type="hidden" name="score" value="@score" />

    <div class="col-sm-3">
        <label class="form-label">科別</label>
        @Html.DropDownList("qclass", (SelectList)ViewBag.ClassList, "（全部）", new { @class = "form-select" })
    </div>
    <div class="col-sm-2">
        <label class="form-label">題型</label>
        @Html.DropDownList("qtype", (SelectList)ViewBag.QtypeList, "（全部）", new { @class = "form-select" })
    </div>
    <div class="col-sm-2">
        <label class="form-label">章</label>
        @Html.DropDownList("chapter", (SelectList)ViewBag.ChapterList, "（全部）", new { @class = "form-select" })
    </div>
    <div class="col-sm-2">
        <label class="form-label">節</label>
        @Html.DropDownList("session", (SelectList)ViewBag.SessionList, "（全部）", new { @class = "form-select" })
    </div>
    <div class="col-sm-3">
        <label class="form-label">關鍵字</label>
        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="搜尋題目內容…" />
    </div>
    <div class="col-12">
        <button class="btn btn-primary me-2" type="submit">套用篩選</button>
        <a class="btn btn-outline-secondary" href="@Url.Action("SelectQuestions", new { id = examId, score = score })">清除</a>
    </div>
</form>

@using (Html.BeginForm("SelectQuestions", "ManageExams", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="examMasterPK" value="@examId" />
    <input type="hidden" name="scorePerQuestion" value="@score" />

    <div class="card-clean p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width:60px;"></th>
                        <th>題目內容</th>
                        <th style="width:120px;">題型</th>
                        <th style="width:140px;">科別</th>
                        <th style="width:120px;">章</th>
                        <th style="width:120px;">節</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">沒有符合篩選條件的題目。</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var q in Model)
                        {
                            <tr>
                                <td>
                                    <input type="checkbox" name="selectedQIds" value="@q.MQBPK" />
                                </td>
                                <td>
                                    <div class="fw-medium">@Html.Raw(q.QContent)</div>
                                    <div class="small text-secondary">
                                        A.@q.QOptionA　B.@q.QOptionB　C.@q.QOptionC　D.@q.QOptionD
                                    </div>
                                </td>
                                <td>@q.QType</td>
                                <td>@q.MQBClassName1</td>
                                <td>@q.MQBChapter</td>
                                <td>@q.MQBSession</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex justify-content-between align-items-center">
        <div>
            @Html.PagedListPager(
                Model,
                pg => Url.Action("SelectQuestions", new
                     {
                    id = examId,
                    score = score,
                    qclass = qclass,
                    qtype = qtype,
                    chapter = chapter,
                    session = session,
                    keyword = keyword,
                    page = pg
                }),
                new PagedListRenderOptions
                {
                    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                    DisplayLinkToLastPage = PagedListDisplayMode.Always,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always
                }
            )
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">加入所選題目</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("Details", new { id = examId })">返回測驗卷</a>
        </div>
    </div>
}
