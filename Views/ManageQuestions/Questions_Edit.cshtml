@model 專題MVC修正.Models.MoodQuestionBank
@{
    ViewBag.Title = "編輯題目";
}

<h2>編輯題目</h2>

@using (Html.BeginForm("Questions_Edit", "ManageQuestions", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <!-- ✅ 主鍵要帶回 POST -->
    @Html.HiddenFor(m => m.MQBPK)

    <!-- 題組 -->
    <div class="form-group mb-3">
        <label>題組：</label>
        @Html.DropDownListFor(m => m.MQBTeamPK,
            (SelectList)ViewBag.MQBTeamPK, "請選擇題組",
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.MQBTeamPK, "", new { @class = "text-danger" })
    </div>

    <!-- 類別 QClass -->
    <div class="form-group mb-3">
        <label>題目分類（QClass）：</label>
        @Html.DropDownListFor(m => m.QClass,
            (SelectList)ViewBag.QClass, "請選擇分類",
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.QClass, "", new { @class = "text-danger" })
    </div>

    <!-- 題型 -->
    <div class="form-group mb-3">
        <label>題型 (QType)：</label>
        @Html.TextBoxFor(m => m.QType, new { @class = "form-control", placeholder = "1=單選, 2=多選, 3=填充, 4=問答" })
    </div>

    <!-- 題目內容 -->
    <div class="form-group mb-3">
        <label>題目內容：</label>
        @Html.TextAreaFor(m => m.QContent, 5, 80, new { @class = "form-control", required = "required" })
    </div>

    <!-- 選項 -->
    <div class="form-group mb-2">
        <label>選項 A：</label>
        @Html.TextBoxFor(m => m.QOptionA, new { @class = "form-control" })
    </div>
    <div class="form-group mb-2">
        <label>選項 B：</label>
        @Html.TextBoxFor(m => m.QOptionB, new { @class = "form-control" })
    </div>
    <div class="form-group mb-2">
        <label>選項 C：</label>
        @Html.TextBoxFor(m => m.QOptionC, new { @class = "form-control" })
    </div>
    <div class="form-group mb-3">
        <label>選項 D：</label>
        @Html.TextBoxFor(m => m.QOptionD, new { @class = "form-control" })
    </div>

    <!-- 標準答案 -->
    <div class="form-group mb-3">
        <label>標準答案 (QAns)：</label>
        @Html.TextBoxFor(m => m.QAns, new { @class = "form-control", placeholder = "例如：A 或 ABC" })
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">儲存變更</button>
        <a href="@Url.Action("Questions_Index")" class="btn btn-secondary">返回列表</a>
    </div>
}
