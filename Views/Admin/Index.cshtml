@{
    ViewBag.Title = "管理後台";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">管理後台首頁</h2>
    <p class="text-secondary mb-4">請選擇要管理的項目：</p>

    <div class="row g-4">

        <!-- 題目管理 -->
        <div class="col-md-3">
            <div class="card-clean p-4 text-center h-100 shadow-sm border-0">
                <div class="mb-3">
                    <i class="bi bi-journal-text" style="font-size: 2.5rem; color:#0d6efd;"></i>
                </div>
                <h5 class="fw-bold mb-2">題目管理</h5>
                <p class="text-secondary mb-3">新增、修改與刪除題庫內容。</p>
                <a href="@Url.Action("Questions_Index", "ManageQuestions")" class="btn btn-primary px-4">前往題目管理</a>
            </div>
        </div>

        <!-- 學生資料管理 -->
        <div class="col-md-3">
            <div class="card-clean p-4 text-center h-100 shadow-sm border-0">
                <div class="mb-3">
                    <i class="bi bi-person-lines-fill" style="font-size: 2.5rem; color:#0d6efd;"></i>
                </div>
                <h5 class="fw-bold mb-2">學生資料管理</h5>
                <p class="text-secondary mb-3">管理學生的基本資料與帳號。</p>
                <a href="@Url.Action("Std_Index", "UsersStd")" class="btn btn-outline-primary px-4">前往學生管理</a>
            </div>
        </div>

        <!-- 測驗卷管理 -->
        <div class="col-md-3">
            <div class="card-clean p-4 text-center h-100 shadow-sm border-0">
                <div class="mb-3">
                    <i class="bi bi-file-earmark-text" style="font-size: 2.5rem; color:#198754;"></i>
                </div>
                <h5 class="fw-bold mb-2">測驗卷管理</h5>
                <p class="text-secondary mb-3">建立、編輯與檢視模擬考試卷。</p>
                <a href="@Url.Action("Exam_Index", "ExamHistory")" class="btn btn-outline-success px-4">前往測驗卷管理</a>
            </div>
        </div>

        <!-- 測驗本管理 -->
        <div class="col-md-3">
            <div class="card-clean p-4 text-center h-100 shadow-sm border-0">
                <div class="mb-3">
                    <i class="bi bi-book-half" style="font-size: 2.5rem; color:#dc3545;"></i>
                </div>
                <h5 class="fw-bold mb-2">測驗本管理</h5>
                <p class="text-secondary mb-3">查看所有學生的作答紀錄並管理測驗結果。</p>
                <a href="@Url.Action("Index", "ExamBook")" class="btn btn-outline-danger px-4">前往測驗本管理</a>
            </div>
        </div>

    </div>

    <!-- 新增：回首頁按鈕 -->
    <div class="mt-5 text-center">
        <a href="@Url.Action("Index", "Home")" class="btn btn-secondary px-5 py-2">
            回首頁
        </a>
    </div>

</div>
