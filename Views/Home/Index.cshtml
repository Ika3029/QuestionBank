@{
    ViewBag.Title = "首頁";
}
<div class="row g-4">
    <!-- 左：Hero + 功能卡 -->
    <div class="col-lg-8">
        <section class="hero card-clean p-4 p-lg-5">
            <h1 class="display-6 fw-extrabold lh-sm mb-3">
                為學生量身打造的練習題庫
            </h1>
            <p class="text-secondary mb-4">
                模擬考模式、單題練習、錯題本與個人化弱點分析，讓你在國考與課業準備上更有方向。
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="@Url.Action("Practice","Home")" class="btn btn-primary btn-lg px-4">立即開始練習</a>
                <a href="@Url.Action("Analytics","Home")" class="btn btn-outline-secondary btn-lg px-4">查看成績分析</a>
            </div>
        </section>

        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <div class="card-clean h-100 p-4">
                    <a href="@Url.Action("Exams_Index", "ManageExams")" class="btn btn-primary btn-lg px-4"><h5 class="fw-bold mb-1">模擬考</h5></a>
                        
                        <p class="text-secondary mb-0">限時模擬真實考場。</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-clean h-100 p-4">
                    <h5 class="fw-bold mb-1">錯題本</h5>
                    <p class="text-secondary mb-0">自動收集你曾答錯的題目。</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-clean h-100 p-4">
                    <h5 class="fw-bold mb-1">智能推薦</h5>
                    <p class="text-secondary mb-0">依弱項推薦，加強記憶曲線。</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card-clean h-100 p-4">
                    <h5 class="fw-bold mb-1">解析深度</h5>
                    <p class="text-secondary mb-0">提供詳盡步驟與重點註記。</p>
                </div>
            </div>
        </div>

        
    </div>

   
</div>
